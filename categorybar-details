    rel="stylesheet">

  <style>

    body{
      margin:0;
      background-color:whitesmoke;
      font-family:Arial, Helvetica, sans-serif;
    }

    /* TOP HEADER */

    .top-header{
      display:flex;
      background:black;
      color:white;
      padding:8px 15px;
      align-items:center;
    }

    .left{
      flex:1;
    }

    .center{
      flex:1;
      text-align:center;
    }

    .right{
      flex:1;
      text-align:right;
    }

    .top-header a{
      color:white;
      text-decoration:none;
      font-size:13px;
    }

    /* MAIN HEADER */

    .header{
      background-image:linear-gradient(to right,rgb(230,224,232),rgb(127,73,138));
      overflow:hidden;
      padding:10px 15px;
    }

    .logo{
      float:left;
      color:purple;
      font-size:30px;
      font-weight:bold;
      text-decoration:none;
      padding:10px;
      transition:0.3s;
    }

    .logo:hover{
      color:white;
      background:black;
      transform:scale(1.05);
    }

    .header-right{
      float:right;
    }

    .header-right a{
      color:white;
      text-decoration:none;
      padding:12px;
      display:inline-block;
      border-radius:6px;
      transition:0.3s;
    }

    .header-right a:hover{
      background:white;
      color:purple;
    }

    /* CATEGORY BAR */

    .categorybar{
      background-color:rgb(90,26,90);
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:10px 15px;
      flex-wrap:wrap;
      gap:15px;
    }

    .category-left{
      display:flex;
      gap:15px;
      flex-wrap:wrap;
    }

    .category-left a{
      color:white;
      text-decoration:none;
      padding:8px 12px;
      border-radius:5px;
      font-size:14px;
      transition:0.3s;
    }

    .category-left a:hover{
      background:white;
      color:purple;
    }

    .active-category{
      background:white;
      color:purple !important;
    }

    /* SEARCH */

    .searchbar{
      display:flex;
    }

    .searchbar input{
      padding:8px;
      border:none;
      outline:none;
      width:220px;
      border-radius:5px 0 0 5px;
    }

    .searchbar button{
      border:none;
      padding:8px 14px;
      background:rgb(202,202,120);
      color:white;
      border-radius:0 5px 5px 0;
      cursor:pointer;
    }

    .searchbar button:hover{
      background:black;
    }

    /* ICONS */

    .category-right{
      display:flex;
      gap:15px;
    }

    .category-right a{
      color:white;
      font-size:18px;
      padding:8px;
      border-radius:50%;
      transition:0.3s;
    }

    .category-right a:hover{
      background:white;
      color:purple;
    }

    /* TITLE */

    .page-title{
      text-align:center;
      margin-top:30px;
      color:purple;
      font-size:36px;
    }

    .subtitle{
      text-align:center;
      color:gray;
      margin-bottom:30px;
    }

    /* PRODUCTS */

    .products-section{
      padding:20px;
    }

    .card{
      background:white;
      border-radius:12px;
      padding:15px;
      box-shadow:0px 0px 10px lightgray;
      position:relative;
      text-align:center;
      transition:0.3s;

      height:100%;
      display:flex;
      flex-direction:column;
    }

    .card:hover{
      transform:translateY(-5px);
    }

    .card img{
      width:100%;
      height:220px;
      object-fit:cover;
      border-radius:10px;
    }

    .card h3{
      margin-top:12px;
      font-size:22px;
    }

    .category-name{
      color:gray;
      font-size:14px;
    }

    .price{
      font-size:18px;
      font-weight:bold;
    }

    /* BUTTON GROUP */

    .button-group{
      margin-top:auto;
      display:flex;
      gap:10px;
    }

    .btn-cart{
      width:50%;
      border:none;
      padding:10px;
      border-radius:5px;
      color:white;
      cursor:pointer;
      background-image:linear-gradient(to right,rgb(113,37,134),rgb(211,211,202));
      transition:0.3s;
    }

    .btn-cart:hover{
      background:black;
      transform:scale(1.03);
    }

    .btn-buy{
      width:50%;
      border:none;
      padding:10px;
      border-radius:5px;
      color:white;
      cursor:pointer;
      background-image:linear-gradient(to right,rgb(113,37,134),rgb(211,211,202));
      transition:0.3s;
    }

    .btn-buy:hover{
        background:black ;
      transform:scale(1.03);
    }

    /* WISHLIST */

    .wishlist{
      position:absolute;
      top:20px;
      right:20px;
      color:white;
      font-size:20px;
      cursor:pointer;
      transition:0.3s;
    }

    .wishlist:hover{
      color:red;
      transform:scale(1.2);
    }

  </style>

</head>

