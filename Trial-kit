<!-- FONT AWESOME -->

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<!-- BOOTSTRAP CSS -->

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<style>

body{
  margin:0;
  background-color:whitesmoke;
  font-family:Arial, Helvetica, sans-serif;
}

/* ================= TOP HEADER ================= */

.top-header{
  display:flex;
  background:black;
  align-items:center;
  padding:1px 0px;
}

.left{
  flex:1;
  color:white;
  text-align:left;
}

.center{
  flex:1;
  color:white;
  text-align:center;
}

.right{
  flex:1;
  color:white;
  text-align:right;
}

.top-header a{
  color:white;
  text-decoration:none;
}

/* ================= MAIN HEADER ================= */

.header{
  background-image:linear-gradient(to right,
  rgb(230,224,232),
  rgb(127,73,138));
  overflow:hidden;
  padding:9px 12px;
}

.logo{
  color:purple;
  font-size:24px;
  font-weight:bold;
  text-decoration:none;
  float:left;
  padding:12px 15px;
}

.logo:hover{
  background:black;
  color:white;
  border-radius:5px;
}

.header-right{
  float:right;
}

.header-right a{
  display:inline-block;
  color:white;
  text-decoration:none;
  padding:10px 12px;
  font-size:12px;
}

.header-right a:hover,
.header-right a.active{
  background:black;
  color:white;
  border-radius:5px;
}

/* ================= CATEGORY BAR ================= */

 .categorybar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      background-color:rgb(90,26,90);
      padding:7px 15px;
    }

    .categorybar .left{
      display:flex;
      align-items:center;
      gap:25px;
    }

    .categorybar .left a{
      color:white;
      text-decoration:none;
      font-size:12px;
      transition:0.3s;
    }

    .categorybar .left a:hover,
    .categorybar .left a.active-category{
      color:rgb(48, 29, 48);
       background-color:white;
       padding:8px 14px;
       font-weight:bold;
       border-radius:5px;
      transform:scale(1.05);
    }

    .categorybar .left a.active-category{
      padding:8px 14px;
      font-weight:bold;
      border-radius:5px;
    }


.categorybar .center{
  display:flex;
  justify-content:center;
  flex-grow:1;
}

.searchbar{
  display:flex;
}

.searchbar input{
  padding:7px;
  border:none;
  outline:none;
  border-radius:4px 0 0 4px;
}

.searchbar button{
  padding:7px 12px;
  border:none;
  background-color:rgb(180,180,93);
  color:white;
  cursor:pointer;
  border-radius:0 4px 4px 0;
}

.searchbar button:hover{
  background:white;
  color:purple;
}

.categorybar .right{
  display:flex;
  gap:20px;
  justify-content:flex-end;
}

.categorybar .right a{
  color:white;
  font-size:18px;
  transition:0.3s;
}

.categorybar .right a:hover{
  color:red;
  transform:scale(1.2);
}

/* ================= MAIN SECTION ================= */

.main-section{
  display:flex;
  padding:20px;
  gap:20px;
  flex-wrap:wrap;
}

/* ================= SIDEBAR ================= */

.sidebar{
  width:250px;
  background:white;
  padding:20px;
  border-radius:10px;
  box-shadow:0px 0px 10px lightgray;
  height:fit-content;
}

.sidebar h2{
  color:purple;
  margin-bottom:20px;
}

.sidebar a{
  display:block;
  text-decoration:none;
  color:black;
  padding:12px;
  font-weight:bold;
  border-radius:5px;
  margin-bottom:10px;
  transition:0.3s;
}

.sidebar a:hover{
  background:rgb(230,230,230);
  color:purple;
  padding-left:18px;
}

/* ACTIVE KIT */

.sidebar a.active{
  background:purple;
  color:white;
  font-weight:bold;
}

/* ================= PRODUCTS ================= */

.products{
  flex:1;
}

.products h2{
  color:purple;
  margin-bottom:20px;
}

.product-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:20px;
}

.card{
  background:white;
  padding:15px;
  border-radius:12px;
  text-align:center;
  box-shadow:0px 0px 10px lightgray;
  transition:0.3s;
  position:relative;
  border:none;
}

.card:hover{
  transform:translateY(-5px);
}

.card img{
  width:100%;
  height:220px;
  border-radius:10px;
  object-fit:cover;
}

.card h3{
  margin-top:10px;
}

.price{
  font-size:18px;
  font-weight:bold;
}

.btn-custom{
  border:none;
  color:white;
  padding:10px 18px;
  border-radius:5px;
  cursor:pointer;
  margin-top:10px;
  background-image:linear-gradient(to right,
  rgb(113,37,134),
  rgb(211,211,202));
  transition:0.3s;
}

.btn-custom:hover{
  padding:14px 20px;
  color:white;
}

/* WISHLIST */

.wishlist{
  position:absolute;
  top:20px;
  right:20px;
  color:white;
  cursor:pointer;
  transition:0.3s;
}

.wishlist:hover{
  color:red;
  transform:scale(1.2);
}

/* RESPONSIVE */

@media(max-width:768px){

  .header{
    text-align:center;
  }

  .logo{
    float:none;
    display:block;
  }

  .header-right{
    float:none;
    margin-top:10px;
  }

  .sidebar{
    width:100%;
  }

}

</style>

</head>

