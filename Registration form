<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Lumira Registration Form</title>

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<!--icon list-->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

<style>

body{
    margin:0;
    font-family:Arial, sans-serif;
    background:whitesmoke;
}

/* TOP HEADER */

.top-header{
    background:black;
    color:white;
    font-size:14px;
}

.top-header a{
    color:white;
    text-decoration:none;
}

/* MAIN HEADER */

.header{
    background:whitesmoke;
    border-bottom:1px solid lightgray;
}

.logo{
    color:purple;
    font-size:30px;
    font-weight:bold;
    transition:0.3s;
}

.logo:hover{
    background:black;
    color:white;
    border-radius:5px;
    padding:5px 10px;
}

.header-right a{
    text-decoration:none;
    color:black;
    font-size:15px;
    transition:0.3s;
    padding:8px 12px;
    border-radius:5px;
}

.header-right a:hover{
    background:black;
    color:white;
}



/* FORM */

.form-container{
    background:white;
    border-radius:18px;
    box-shadow:0 0 18px rgba(0,0,0,0.15);
    border-top:6px solid purple;
}

.form-container h2{
    color:black;
    font-size:32px;
}

/* INPUTS */

.input-box label{
    font-weight:bold;
    color:black;
}

.input-box input,
.input-box select{
    transition:0.3s;
}

.input-box input:focus,
.input-box select:focus{
    border-color:black;
    transform:scale(1.02);
    box-shadow:0 0 8px rgba(128,0,128,0.2);
}

/* BUTTON */

.register-btn{
    background:rgb(90, 26, 90);
    color:white;
    font-size:17px;
    transition:0.3s;
}

.register-btn:hover{
    background:black;
    color:white;
    transform:scale(1.03);
}

/* DIVIDER */

.divider{
    display:flex;
    align-items:center;
}

.divider::before,
.divider::after{
    content:"";
    flex:1;
    height:1px;
    background:lightgray;
}

.divider span{
    margin:0 10px;
    color:gray;
}

/* SOCIAL LOGIN */

.social-btn{
    border:1px solid lightgray;
    background:white;
    transition:0.3s;
}

.social-btn:hover{
    background:whitesmoke;
    transform:scale(1.03);
    border-color:black;
}

.social-btn i{
    font-size:18px;
    color:black;
}

/* BOTTOM TEXT */

.bottom-text a{
    color:maroon;
    text-decoration:none;
    font-weight:bold;
}

.bottom-text a:hover{
    color:black;
}

</style>
</head>

<body>

<!-- TOP HEADER -->

<div class="top-header py-2">
    <div class="container-fluid">
        <div class="row text-center text-md-start">

            <div class="col-md-4 mb-1 mb-md-0">
                <a href="#">Track your order</a>
            </div>

            <div class="col-md-4 mb-1 mb-md-0 text-md-center">
                <a href="#">Call +12345 879 541</a>
            </div>

            <div class="col-md-4 text-md-end">
                ENG | USD
            </div>

        </div>
    </div>
</div>

<!-- MAIN HEADER -->

<div class="header py-3">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center">

            <div class="logo">
                Lumira
            </div>

            <div class="header-right d-flex gap-2">
                <a href="#">Login</a>
                <a href="#">Help</a>
            </div>

        </div>
    </div>
</div>



<!-- REGISTRATION FORM -->

<div class="container my-5">

    <div class="form-container col-lg-5 col-md-7 col-sm-10 mx-auto p-4 p-md-5">

        <h2 class="text-center mb-4">
            Create Account
        </h2>

        <form>

            
                <div class="input-group mb-3">
      <span class="input-group-text">
        <i class="bi bi-person-fill" style="color:purple"></i></span>
      <input type="text" class="form-control"
        placeholder="Enter your full name" required>
    </div>
                

            <div class="input-group mb-3">
        <span class="input-group-text">
        <i class="bi bi-envelope-fill" style="color:purple"></i> </span>
                <input type="email"
                class="form-control"
                placeholder="Enter your email"
                required>
            </div>

            <div class="input-group mb-3"> 
             <span class="input-group-text">
        <i class="bi bi-lock-fill" style="color:purple"></i></span>
                <input type="password"
                class="form-control"
                placeholder="Create password"
                required>
            </div>

            <div class="input-group mb-3">
             <span class="input-group-text">
        <i class="bi bi-gender-neuter" style="color:purple"></i></span>
                <select class="form-select" required>

                    <option value="">
                        Select Gender
                    </option>

                    <option>
                        Male
                    </option>

                    <option>
                        Female
                    </option>

                    <option>
                        Other
                    </option>

                </select>
            </div>

            <div class="input-group mb-4">
         <span class="input-group-text">
        <i class="bi bi-telephone-fill" style="color:purple"></i></span>
                <input type="tel"
                class="form-control"
                placeholder="Enter mobile number"
                required>
            </div>

            <button class="btn register-btn w-100 py-2">
                Register
            </button>

        </form>

        <!-- DIVIDER -->

        <div class="divider my-4">
            <span>OR</span>
        </div>

        <!-- SOCIAL LOGIN -->

        <div class="social-login d-grid gap-3">

            <button class="social-btn btn d-flex align-items-center gap-3 p-3">

                <i class="fa-brands fa-google ms-2"></i>

                Register with Google
            </button>

            <button class="social-btn btn d-flex align-items-center gap-3 p-3">

                <i class="fa-brands fa-apple ms-2"></i>

                Register with Apple ID
            </button>

            <button class="social-btn btn d-flex align-items-center gap-3 p-3">

                <i class="fa-brands fa-facebook-f ms-2"></i>

                Register with Facebook
            </button>

        </div>

        <!-- BOTTOM TEXT -->

        <div class="bottom-text text-center mt-4">

            Already have an account?

            <a href="#">
                Login
            </a>

        </div>

    </div>

</div>

<!-- Bootstrap JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
