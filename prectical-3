<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Grey Layout</title>

  <style>
    *{
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body{
      background-color: #d3d3d3;
    }

    /* Header */
    .header{
      background-color: #808080;
      color: white;
      text-align: center;
      padding: 20px;
      font-size: 28px;
    }

    /* Navigation */
    .nav{
      background-color: #696969;
      padding: 15px;
      text-align: center;
    }

    .nav a{
      color: white;
      text-decoration: none;
      margin: 15px;
      font-size: 18px;
    }

    /* Main Layout */
    .container{
      display: flex;
      margin: 20px;
      gap: 20px;
    }

    /* Sidebar */
    .sidebar{
      width: 25%;
      background-color: #a9a9a9;
      padding: 20px;
      min-height: 300px;
    }

    /* Content */
    .content{
      width: 75%;
      background-color: #c0c0c0;
      padding: 20px;
      min-height: 300px;
    }

    /* Footer */
    .footer{
      background-color: #808080;
      color: white;
      text-align: center;
      padding: 15px;
      margin-top: 20px;
    }

    /* Responsive */
    @media(max-width:768px){
      .container{
        flex-direction: column;
      }

      .sidebar,
      .content{
        width: 100%;
      }
    }

  </style>
</head>
<body>

  <div class="header">
    Grey Layout Website
  </div>

  <div class="nav">
    <a href="#">Home</a>
    <a href="#">About</a>
    <a href="#">Services</a>
    <a href="#">Contact</a>
  </div>

  <div class="container">

    <div class="sidebar">
      <h2>Sidebar</h2>
      <p>This is sidebar section.</p>
    </div>

    <div class="content">
      <h2>Main Content</h2>
      <p>
        This is the main content area of the grey layout.
      </p>
    </div>

  </div>

  <div class="footer">
    Footer Section
  </div>

</body>
</html>
