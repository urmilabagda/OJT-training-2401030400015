          <!-- Modal -->

          <div class="modal fade" id="registerModal" tabindex="-1">

            <div class="modal-dialog modal-dialog-scrollable modal-lg">

              <div class="modal-content">

                <!-- Header -->

                <div class="modal-header">

                  <h5 class="modal-title">
                    Registration Form
                  </h5>

                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                  </button>

                </div>

                <!-- Body -->

                <div class="modal-body">

                  <form>

                    <!-- Email -->

                    <div class="mb-3">

                      <label class="form-label">
                        Email Address
                      </label>

                      <input type="email" class="form-control" placeholder="Enter email">

                    </div>

                    <!-- Password -->

                    <div class="mb-3">

                      <label class="form-label">
                        Password
                      </label>

                      <input type="password" class="form-control" placeholder="Enter password">

                    </div>

                    <!-- Checkbox -->

                    <div class="form-check mb-2">

                      <input class="form-check-input" type="checkbox" id="checkDefault">

                      <label class="form-check-label" for="checkDefault">

                        Are you Member ?

                      </label>

                    </div>

                    <div class="form-check mb-3">

                      <input class="form-check-input" type="checkbox" id="checkChecked" checked>

                      <label class="form-check-label" for="checkChecked">

                        Permanent Member

                      </label>

                    </div>

                    <!-- Gender -->

                    <div class="mb-3">

                      <label class="form-label">
                        Gender
                      </label>

                      <select class="form-select">

                        <option selected>Select Gender</option>

                        <option>Male</option>

                        <option>Female</option>

                        <option>Other</option>

                      </select>

                    </div>

                    <!-- Textarea -->

                    <div class="mb-3">

                      <label class="form-label">
                        Describe Yourself
                      </label>

                      <textarea class="form-control" rows="3" placeholder="Write something about yourself">
              </textarea>

                    </div>

                  </form>

                </div>

                <!-- Footer -->

                <div class="modal-footer">


                  <button type="button" class="btn btn-danger">

                    Register

                  </button>

                </div>

              </div>

