<!DOCTYPE html>
<html>

<head>

  <title>Lumira About Us</title>

  <!-- Bootstrap CSS -->

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Font Awesome -->

  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>

    body{
      margin:0;
      background-color:whitesmoke;
      font-family:Arial, Helvetica, sans-serif;
    }

    /* TOP HEADER */

    .top-header{
      display:flex;
      background:black;
      align-items:center;
      padding:8px 15px;
    }

    .top-header .left{
      flex:1;
      text-align:left;
    }

    .top-header .center{
      flex:1;
      text-align:center;
    }

    .top-header .right{
      flex:1;
      text-align:right;
      color:white;
    }

    .top-header a{
      color:white;
      text-decoration:none;
      font-size:14px;
    }

    /* MAIN HEADER */

    .header{
      background-color:whitesmoke;
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:15px 30px;
      box-shadow:0 2px 5px rgba(0,0,0,0.1);
    }

    .logo{
      color:purple;
      font-size:35px;
      font-weight:bold;
      padding:8px 15px;
      text-decoration:none;
    }

    .logo:hover{
      color:white;
      background:black;
      border-radius:5px;
    }

    .header-right a{
      text-decoration:none;
      color:black;
      margin-left:20px;
      font-weight:bold;
      transition:0.3s;
    }

    .header-right a:hover{
      color:rgb(239, 234, 239);
      background-color: black;
    }

    .header-right a.active{
      color:rgb(234, 222, 234);
      background-color: black;
      padding-bottom:4px;
    }

    /* ABOUT HERO */

    .about-hero{
      text-align:center;
      padding:90px 20px 70px;
      background:linear-gradient(to right,#f5f5f5,#ece1f8);
    }

    .about-hero h1{
      font-size:65px;
      margin-bottom:20px;
      color:purple;
    }

    .about-hero p{
      max-width:850px;
      margin:auto;
      font-size:22px;
      color:gray;
      line-height:1.8;
    }

    /* ABOUT SECTION */

    .about-section{
      width:90%;
      max-width:1200px;
      margin:80px auto;
      display:flex;
      gap:50px;
      align-items:center;
      flex-wrap:wrap;
    }

    .about-image{
      flex:1;
      min-width:320px;
    }

    .about-image img{
      width:100%;
      object-fit:cover;
      border-radius:25px;
      box-shadow:0 5px 18px rgba(0,0,0,0.15);
    }

    .about-content{
      flex:1;
      min-width:320px;
    }

    .about-content h2{
      font-size:45px;
      margin-bottom:25px;
      color:purple;
    }

    .about-content p{
      color:#555;
      line-height:2;
      font-size:18px;
      margin-bottom:20px;
    }

    /* VALUES */

    .values-section{
      width:90%;
      margin:0 auto 90px;
    }

    .values-title{
      text-align:center;
      margin-bottom:50px;
    }

    .values-title h1{
      font-size:50px;
      color:purple;
    }

    .values-container{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
      gap:30px;
    }

    .value-card{
      background:white;
      padding:40px 30px;
      border-radius:22px;
      text-align:center;
      box-shadow:0 5px 18px rgba(0,0,0,0.12);
      transition:0.3s;
    }

    .value-card:hover{
      transform:translateY(-8px);
    }

    .value-card i{
      width:90px;
      height:90px;
      background:purple;
      color:white;
      border-radius:50%;
      display:flex;
      justify-content:center;
      align-items:center;
      font-size:35px;
      margin:0 auto 25px;
    }

    .value-card h2{
      margin-bottom:15px;
    }

    .value-card p{
      color:gray;
      line-height:1.8;
    }

    /* STATS */

    .stats-section{
      background:purple;
      color:white;
      padding:80px 20px;
    }

    .stats-container{
      width:90%;
      max-width:1200px;
      margin:auto;
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
      gap:30px;
      text-align:center;
    }

    .stat-box h1{
      font-size:55px;
      color:gold;
      margin-bottom:10px;
    }

    .stat-box p{
      font-size:20px;
    }

    /* TEAM */

    .team-section{
      width:90%;
      margin:90px auto;
    }

    .team-title{
      text-align:center;
      margin-bottom:50px;
    }

    .team-title h1{
      font-size:50px;
      color:purple;
    }

    .team-container{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
      gap:30px;
    }

    .team-card{
      background:white;
      border-radius:22px;
      overflow:hidden;
      text-align:center;
      box-shadow:0 5px 18px rgba(0,0,0,0.12);
      transition:0.3s;
    }

    .team-card:hover{
      transform:translateY(-8px);
    }

    .team-card img{
      width:100%;
      height:320px;
      object-fit:cover;
    }

    .team-card h2{
      margin:20px 0 10px;
    }

    .team-card p{
      color:gray;
      margin-bottom:25px;
    }

    /* FOOTER CTA */

    .footer-cta{
      background:purple;
      color:white;
      text-align:center;
      padding:80px 20px;
    }

    .footer-cta h1{
      font-size:55px;
      margin-bottom:20px;
    }

    .footer-cta p{
      font-size:20px;
      margin-bottom:35px;
    }

    .shop-btn{
      text-decoration:none;
      background:black;
      color:white;
      padding:18px 40px;
      border-radius:10px;
      font-size:18px;
      font-weight:bold;
      transition:0.3s;
    }

    .shop-btn:hover{
      background:white;
      color:purple;
    }

  </style>

</head>

