<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Lumira Web Page</title>

  <!-- BOOTSTRAP CSS -->

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- FONT AWESOME -->

  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    body {
      margin: 0;
      background-color: whitesmoke;
      font-family: Arial, Helvetica, sans-serif;
    }

    /* ================= TOP HEADER ================= */

    .top-header {
      background-color: black;
      color: white;
      padding: 8px 0;
      font-size: 14px;
    }

    .top-header a {
      color: white;
      text-decoration: none;
    }

    /* ================= MAIN HEADER ================= */

    .main-header {
      background-image: linear-gradient(to right, rgb(230, 224, 232), rgb(127, 73, 138));
      padding: 12px 0;
    }

    .logo {
      color: purple;
      font-size: 24px;
      font-weight: bold;
      text-decoration: none;
      padding: 10px 15px;
      border-radius: 5px;
      transition: 0.3s;
    }

    .logo:hover {
      background-color: black;
      color: white;
    }

    .header-btn {
      color: white;
      text-decoration: none;
      padding: 10px 14px;
      border-radius: 5px;
      transition: 0.3s;
      font-size: 14px;
    }

    .header-btn:hover,
    .header-btn.active {
      background-color: black;
      color: white;
    }

    /* ================= CATEGORY BAR ================= */

    .categorybar {
      background-color: rgb(90, 26, 90);
      padding: 12px 0;
    }

    .categorybar a {
      color: white;
      text-decoration: none;
      font-size: 14px;
      transition: 0.3s;
    }

    .categorybar a:hover,
    .active-category {
      color: rgb(180, 180, 93);
      font-weight: bold;
    }

    .search-btn {
      background-color: rgb(180, 180, 93);
      color: white;
      border: none;
    }

    .search-btn:hover {
      background-color: white;
      color: purple;
    }

    .icon-link {
      color: white;
      font-size: 18px;
      transition: 0.3s;
    }

    .icon-link:hover {
      color: red;
      transform: scale(1.2);
    }

    /* ================= SIDEBAR ================= */

    .sidebar {
      background-color: white;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0px 0px 10px lightgray;
    }

    .sidebar h2 {
      color: purple;
      margin-bottom: 20px;
    }

    .sidebar a {
      display: block;
      text-decoration: none;
      color: black;
      padding: 12px;
      border-radius: 5px;
      margin-bottom: 8px;
      transition: 0.3s;
    }

    .sidebar a.active {
      background-color: purple;
      color: white;
      font-weight: bold;
    }

    .sidebar a:hover {
      background-color: rgb(230, 230, 230);
      color: purple;
      padding-left: 18px;
    }

    /* ================= PRODUCTS ================= */

    .products h2 {
      color: purple;
      margin-bottom: 20px;
    }

    .card {
      border: none;
      border-radius: 12px;
      box-shadow: 0px 0px 10px lightgray;
      transition: 0.3s;
      position: relative;
      overflow: hidden;
    }

    .card:hover {
      transform: translateY(-5px);
    }

    .card img {
      height: 220px;
      object-fit: cover;
      border-radius: 10px;
    }

    .price {
      color: black;
      font-weight: bold;
      font-size: 18px;
    }

    .btn-custom {
      color: white;
      border: none;
      padding: 10px 18px;
      border-radius: 5px;
      background-image: linear-gradient(to right, rgb(113, 37, 134), rgb(211, 211, 202));
      transition: 0.3s;
    }

    .btn-custom:hover {
      padding: 12px 20px;
    }

    /* ================= WISHLIST ================= */

    .wishlist {
      position: absolute;
      top: 20px;
      right: 20px;
      color: white;
      width: 35px;
      height: 35px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: 0.3s;
      z-index: 1;
    }

    .wishlist:hover {
      color: red;
      transform: scale(1.1);
    }
  </style>

</head>

<body>

  <!-- TOP HEADER -->

  <div class="top-header">

    <div class="container">

      <div class="row align-items-center text-center text-md-start">

