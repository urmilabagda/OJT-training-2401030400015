<!DOCTYPE html>
<html lang="en">

<head>
  <title>Lumira Web Page</title>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Font Awesome -->
  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>

    body {
      margin: 0;
      background-color: whitesmoke;
      font-family: Arial, Helvetica, sans-serif;
    }

    /* TOP HEADER */

    .top-header {
      display: flex;
      background-color: black;
      align-items: center;
      padding: 6px 20px;
    }

    .left {
      flex: 1;
      color: white;
      text-align: left;
    }

    .center {
      flex: 1;
      color: white;
      text-align: center;
    }

    .right {
      flex: 1;
      color: white;
      text-align: right;
    }

    .top-header a {
      color: white;
      text-decoration: none;
    }

    /* MAIN HEADER */

    .header {
      background-color: whitesmoke;
      overflow: hidden;
      padding: 10px 20px;
    }

    .header .logo {
      color: purple;
      font-size: 28px;
      font-weight: bold;
      text-decoration: none;
      float: left;
      padding: 10px 15px;
      transition: 0.3s;
    }

    .header .logo:hover {
      background-color: black;
      color: white;
      border-radius: 5px;
    }

    .header-right {
      float: right;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .header-right a {
      display: inline-block;
      color: black;
      text-align: center;
      padding: 10px 14px;
      text-decoration: none;
      font-size: 14px;
      transition: 0.3s;
    }

    .header-right a:hover {
      background-color: black;
      color: white;
      border-radius: 5px;
    }

    .header-right a.active {
      background-color: black;
      color: white;
      border-radius: 5px;
    }

    /* LANGUAGE SELECT */

    .language-select {
      width: 130px;
      border-radius: 30px;
      font-size: 14px;
    }

    /* CATEGORY BAR */

    .categorybar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background-color: rgb(90, 26, 90);
      padding: 10px 20px;
      flex-wrap: wrap;
      gap: 15px;
    }

    /* LEFT CATEGORY */

    .categorybar .left {
      display: flex;
      align-items: center;
      gap: 25px;
      flex-wrap: wrap;
    }

    .categorybar .left a {
      color: white;
      text-decoration: none;
      font-size: 15px;
      transition: 0.3s;
    }

    .categorybar .left a:hover {
      color: rgb(177, 177, 57);
      transform: scale(1.1);
    }

    /* SEARCH */

    .searchbar {
      display: flex;
      align-items: center;
    }

    .searchbar input {
      padding: 8px 12px;
      border: none;
      outline: none;
      border-radius: 5px 0 0 5px;
      width: 230px;
    }

    .searchbar button {
      padding: 8px 14px;
      border: none;
      background-color: rgb(180, 180, 93);
      color: white;
      border-radius: 0 5px 5px 0;
      transition: 0.3s;
    }

    .searchbar button:hover {
      background-color: white;
      color: purple;
    }

    /* RIGHT ICONS */

    .category-icons {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .category-icons a {
      color: white;
      font-size: 18px;
      text-decoration: none;
      transition: 0.3s;
    }

    .category-icons a:hover {
      color: red;
      transform: scale(1.2);
    }

    /* BANNER IMAGE */

    .banner-image {
      width: 100%;
      height: auto;
      object-fit: cover;
    }

  </style>
</head>

<body>

  <!-- TOP HEADER -->

  <div class="top-header">

    <div class="left">
      <a href="#">Track your order</a>
    </div>

    <div class="center">
      <a href="tel:+12345879541">Call +12345 879 541</a>
    </div>

    <div class="right">

      <!-- Bootstrap Language Dropdown -->

      <div class="dropdown d-inline">

        <button class="btn btn-sm btn-light dropdown-toggle"
          type="button"
          data-bs-toggle="dropdown">

          English

        </button>

        <ul class="dropdown-menu">

          <li>
            <a class="dropdown-item" href="#">English</a>
          </li>

          <li>
            <a class="dropdown-item" href="#">Hindi</a>
          </li>

          <li>
            <a class="dropdown-item" href="#">Gujarati</a>
          </li>

          <li>
            <a class="dropdown-item" href="#">French</a>
          </li>

        </ul>

      </div>

    </div>

  </div>

  <!-- HEADER -->

  <div class="header">

    <a href="#" class="logo">Lumira</a>

    <div class="header-right">

      <!-- Bootstrap Language Select -->

      <select class="form-select language-select">

        <option>English</option>
        <option>Hindi</option>
        <option>Gujarati</option>
        <option>French</option>

      </select>

      <a class="active" href="#login">Login</a>
      <a href="#signup">Register</a>
      <a href="#help">Help</a>

    </div>

  </div>

  <!-- CATEGORY BAR -->

  <div class="categorybar">

    <!-- LEFT -->

    <div class="left">

      <a href="#">All</a>
      <a href="#">Skincare</a>
      <a href="#">Makeup</a>
      <a href="#">Haircare</a>
      <a href="#">Fragrance</a>
      <a href="#">Trial Kit</a>
      <a href="#">Offers</a>

    </div>

    <!-- SEARCH -->

    <div class="searchbar">

      <input type="text" placeholder="Search here....">

      <button type="submit">
        Search
      </button>

    </div>

    <!-- RIGHT ICONS -->

    <div class="category-icons">

      <a href="#">
        <i class="fa fa-user"></i>
      </a>

      <a href="#">
        <i class="fa fa-heart"></i>
      </a>

      <a href="#">
        <i class="fa fa-shopping-bag"></i>
      </a>

    </div>

  </div>
  <!-- Bootstrap JS -->

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
