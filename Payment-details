<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Payment Details</title>

<!-- FONT AWESOME -->

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<!-- BOOTSTRAP CSS -->

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<style>

/* BODY */

body{
  background-color:whitesmoke;
  font-family:Arial,sans-serif;
  margin:0;
  padding:40px 0;
}

/* ================= PAYMENT SUCCESS PAGE ================= */

.profile-content{
  width:90%;
  max-width:900px;
  margin:auto;
}

.profile-content h1{
  margin-bottom:25px;
  font-weight:bold;
}

/* SUCCESS BOX */

.success-box{
  background:linear-gradient(to right, rgb(113,37,134), rgb(211,211,202));
  color:white;
  padding:30px;
  border-radius:12px;
  text-align:center;
  margin-bottom:25px;
}

.success-box i{
  font-size:60px;
  margin-bottom:15px;
}

.success-box h2{
  margin:10px 0;
}

/* PAYMENT CARD */

.payment-card{
  background:white;
  border-radius:12px;
  padding:25px;
  margin-bottom:20px;
  box-shadow:0px 0px 10px lightgray;
}

.payment-card h2{
  color:purple;
  margin-bottom:20px;
}

/* DETAILS */

.detail-row{
  display:flex;
  justify-content:space-between;
  padding:12px 0;
  border-bottom:1px solid whitesmoke;
}

.detail-row span:first-child{
  font-weight:bold;
}

/* BUTTONS */

.btns{
  display:flex;
  gap:20px;
  margin-top:25px;
  flex-wrap:wrap;
}

.track-btn,
.shop-btn{
  border:none;
  padding:12px 25px;
  border-radius:6px;
  cursor:pointer;
  font-size:15px;
  transition:0.3s;
}

.track-btn{
  background-color:purple;
  color:white;
}

.shop-btn{
  background-color:black;
  color:white;
}

.track-btn:hover,
.shop-btn:hover{
  transform:scale(1.05);
}

/* RESPONSIVE */

@media(max-width:768px){

  .detail-row{
    flex-direction:column;
    gap:6px;
  }

  .btns{
    flex-direction:column;
  }

}

</style>

</head>

<body>

<!-- ================= PAYMENT SUCCESS PAGE ================= -->

<div class="container">

<div class="profile-content">

  <h1>Order Confirmed ✅</h1>

  <!-- SUCCESS MESSAGE -->

  <div class="success-box">

    <i class="fa fa-circle-check"></i>

    <h2>Thank You For Your Order!</h2>

    <p>
      Your payment was successful and your order has been confirmed.
    </p>

  </div>

  <!-- ORDER DETAILS -->

  <div class="payment-card">

    <h2>Order Details</h2>

    <div class="detail-row">
      <span>Order ID</span>
      <span>#LMR458921</span>
    </div>

    <div class="detail-row">
      <span>Product</span>
      <span>Lumira Glow Face Wash</span>
    </div>

    <div class="detail-row">
      <span>Quantity</span>
      <span>2</span>
    </div>

    <div class="detail-row">
      <span>Payment Method</span>
      <span>UPI</span>
    </div>

    <div class="detail-row">
      <span>Product Amount</span>
      <span>₹900</span>
    </div>

    <div class="detail-row">
      <span>Delivery Amount</span>
      <span>₹200</span>
    </div>

    <div class="detail-row">
      <span>Total Amount</span>
      <span>₹1100</span>
    </div>

    <div class="detail-row">
      <span>Delivery Date</span>
      <span>20 May 2026</span>
    </div>

    <hr>

  </div>

  <!-- SHIPPING ADDRESS -->

  <div class="payment-card">

    <h2>Shipping Address</h2>

    <p>
      User Name <br>
      102 Silver Heights,<br>
      Ahmedabad, Gujarat,<br>
      India - 380001
    </p>

  </div>

  <!-- BUTTONS -->

  <div class="btns">

    <button class="track-btn">
      Track Order
    </button>

    <button class="shop-btn">
      Continue Shopping
    </button>

  </div>

</div>

</div>

<!-- BOOTSTRAP JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
