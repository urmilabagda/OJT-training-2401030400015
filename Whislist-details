<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Lumira Wishlist</title>

<!-- FONT AWESOME -->

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<!-- BOOTSTRAP CSS -->

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<style>

body{
  margin:0;
  background-color:whitesmoke;
  font-family:Arial, Helvetica, sans-serif;
}

/* ================= TOP HEADER ================= */

.top-header{
  display:flex;
  background:black;
  color:white;
  padding:5px 20px;
  align-items:center;
}

.left{
  flex:1;
}

.center{
  flex:1;
  text-align:center;
}

.right{
  flex:1;
  text-align:right;
}

.top-header a{
  color:white;
  text-decoration:none;
}

/* ================= MAIN HEADER ================= */

.header{
  background-image:linear-gradient(to right,
  rgb(230,224,232),
  rgb(127,73,138));
  padding:15px 20px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:nowrap;
}

.logo{
  color:purple;
  font-size:24px;
  font-weight:bold;
  text-decoration:none;
  padding:12px 15px;
  cursor:pointer;
  display:block;
}

.logo:hover{
  background-color:black;
  color:white;
  border-radius:5px;
}

.header-right{
  display:flex;
  align-items:center;
  gap:10px;
}

.header-right a{
  text-decoration:none;
  color:black;
  padding:10px 15px;
  border-radius:6px;
}

.header-right a:hover{
  background:black;
  color:white;
}

/* ================= CATEGORY BAR ================= */

.categorybar{
  background:rgb(90,26,90);
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:10px 20px;
  flex-wrap:wrap;
}

.categorybar .left{
  display:flex;
  gap:25px;
  align-items:center;
  flex-wrap:nowrap;
}

.categorybar .left a{
  color:white;
  text-decoration:none;
  white-space:nowrap;
}

.categorybar .left a:hover{
  color:black;
  background-color: white;
  padding: 5px 18px;
  border-radius: 20px;
}

.categorybar .center{
  flex:1;
  display:flex;
  justify-content:center;
}

.searchbar{
  display:flex;
}

.searchbar input{
  padding:8px;
  border:none;
  outline:none;
  border-radius:5px 0 0 5px;
}

.searchbar button{
  padding:8px 15px;
  border:none;
  background:goldenrod;
  color:white;
  border-radius:0 5px 5px 0;
  cursor:pointer;
}

.searchbar button:hover{
  background-color:white;
  color:purple;
}

/* RIGHT ICONS */

.categorybar .right{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:20px;
  margin-left:auto;
}

.categorybar .right a{
  color:white;
  text-decoration:none;
  font-size:18px;
  transition:0.3s;
}

.categorybar .right a:hover{
  color:red;
  transform:scale(1.3);
}

.categorybar .right .active-icon{
  color:red;
  padding:10px;
  border-radius:50%;
}

.categorybar .right .active-icon:hover{
  color:white !important;
  transform:scale(1.2);
}

/* ================= WISHLIST SECTION ================= */

.wishlist-container{
  width:92%;
  margin:40px auto;
}

.wishlist-title{
  text-align:center;
  color:purple;
  font-size:40px;
  margin-bottom:35px;
}

.wishlist-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:25px;
}

.wishlist-card{
  background:white;
  border-radius:18px;
  padding:20px;
  position:relative;
  box-shadow:0px 4px 15px rgba(0,0,0,0.12);
  transition:0.3s;
  text-align:center;
}

.wishlist-card:hover{
  transform:translateY(-6px);
  box-shadow:0px 8px 20px rgba(128,0,128,0.2);
}

.wishlist-card img{
  width:100%;
  height:240px;
  object-fit:cover;
  border-radius:15px;
}

.wishlist-card h2{
  color:purple;
  margin-top:15px;
}

.wishlist-card p{
  color:gray;
}

.price{
  font-size:24px;
  color:black;
  font-weight:bold;
}

/* HEART ICON */

.heart-icon{
  position:absolute;
  top:15px;
  right:15px;
  width:40px;
  height:40px;
  background:white;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  box-shadow:0px 2px 10px rgba(0,0,0,0.15);
  color:red;
  cursor:pointer;
}

/* BUTTONS */

.card-buttons{
  margin-top:15px;
  display:flex;
  justify-content:center;
  align-items:center;
  gap:12px;
}

.add-btn,
.buy-btn{
  border:none;
  padding:10px 18px;
  border-radius:25px;
  cursor:pointer;
  color:white;
  font-weight:bold;
  transition:0.3s;
  height:45px;
}

.add-btn{
  background:purple;
  min-width:120px;
}

.buy-btn{
  background:black;
  min-width:80px;
}

.add-btn:hover{
  background:black;
}

.buy-btn:hover{
  background:purple;
}

/* ================= RESPONSIVE ================= */

@media(max-width:768px){

  .header{
    flex-direction:column;
    gap:10px;
  }

  .categorybar{
    flex-direction:column;
    gap:15px;
  }

}

</style>

</head>

<body>

